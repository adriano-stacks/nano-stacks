# Copy this outside the checkout, replace every value, and configure its path as
# the nano-mainnet-release GitHub environment variable NANO_RELEASE_ENV.

NANO_MAINNET_CAPTURE=/srv/nano-release/mainnet-capture
NANO_MAINNET_RECEIPTS=/srv/nano-release/mainnet-receipts
NANO_MAINNET_CHECKPOINT=/srv/nano-release/mainnet-capture/chainstate/checkpoint-H
NANO_MAINNET_MARF=/srv/nano-release/mainnet-capture/chainstate/checkpoint-H/marf.sqlite
NANO_MAINNET_ARCHIVE=/srv/nano-release/mainnet-chainstate/mainnet/chainstate/vm/index.sqlite
NANO_MAINNET_STATE=/srv/nano-release/mainnet-state
NANO_MAINNET_ANCHOR=8665600
NANO_MAINNET_SIGNER_EVIDENCE=/srv/nano-release/cycle-141-signer-evidence
NANO_NODE_MARF=/srv/nano-release/mainnet-state/chainstate/marf.sqlite
NANO_NODE_CLARITY=/srv/nano-release/mainnet-state/chainstate/clarity.sqlite
NANO_MAINNET_JOURNAL=/srv/nano-release/mainnet-journal.txt
NANO_MAINNET_BLOCKS=/srv/nano-release/mainnet-blocks.bin
NANO_MAINNET_BLOCK=REPLACE_WITH_STATE_TIP_BLOCK_ID
NANO_MAINNET_CHECKPOINT_BLOCK=REPLACE_WITH_CHECKPOINT_BLOCK_ID
NANO_MAINNET_ROOT=REPLACE_WITH_CHECKPOINT_ROOT
NANO_MAINNET_KEY=REPLACE_WITH_MARF_LOOKUP_KEY
# tempfile-backed checkpoint copies must stay on the same reflink-capable
# filesystem as the captured MARF. Do not point this at a tmpfs such as /tmp.
NANO_RELEASE_TMP=/srv/nano-release/tmp
NANO_RELEASE_OUTPUT=/srv/nano-release/artifacts
NANO_RELEASE_CONFIG=/srv/nano-release/config.toml
NANO_RELEASE_ADVISORY_DB=/srv/nano-release/advisory-db
NANO_RELEASE_SECRET_KEY=/srv/nano-release/keys/minisign.key
NANO_RELEASE_PUBLIC_KEY=/srv/nano-release/keys/minisign.pub
NANO_052_SOURCE=/srv/nano-release/mainnet-restored/state/chainstate
NANO_052_SCRATCH=/srv/nano-release/mainnet-052-scratch/state/chainstate
NANO_064_SOURCE=/srv/nano-release/mainnet-restored/state/chainstate
NANO_064_SCRATCH=/srv/nano-release/mainnet-064-scratch/state/chainstate
NANO_086_SOURCE=/srv/nano-release/mainnet-restored/state/chainstate
NANO_086_SCRATCH=/srv/nano-release/mainnet-086-scratch/state/chainstate
NANO_098_SOURCE=/srv/nano-release/mainnet-tip-stopped/state/chainstate
NANO_098_SCRATCH=/srv/nano-release/mainnet-098-scratch/state/chainstate
NANO_111_SOURCE=/srv/nano-release/mainnet-tip-stopped/state/chainstate
NANO_111_SCRATCH=/srv/nano-release/mainnet-111-scratch/state/chainstate
# The qualification job treats every *_SCRATCH value as a same-filesystem path
# template, creates a unique reflink beside it and removes that run's copy after.
NANO_P2P_MAINNET=1

NANO_HOSTED_RPC=http://127.0.0.1:24443
NANO_HACKNET_PEER=http://127.0.0.1:20443
NANO_HACKNET_API=http://127.0.0.1:3999
NANO_HOSTED_SIGNER_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
NANO_HOSTED_START_HEIGHT=REPLACE_WITH_FIRST_HOSTED_STACKS_HEIGHT
NANO_SIGNER_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
NANO_MINER_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
NANO_MINER_BLOCK_ID=REPLACE_WITH_ACCEPTED_NANO_MINED_BLOCK_ID
NANO_FUNDED_KEY=REPLACE_WITH_PRIVATE_KEY
NANO_HACKNET_BLOCKS=20
NANO_HACKNET_CYCLES=2
NANO_HACKNET_TIMEOUT_SECS=1800
NANO_HACKNET_STALL_SECS=300
NANO_EVENT_DIR=/srv/nano-release/nano-events
NANO_STOCK_EVENT_DIR=/srv/nano-release/stock-events
