diff --git a/docker/api/Dockerfile b/docker/api/Dockerfile
new file mode 100644
index 0000000..7d5a9cc
--- /dev/null
+++ b/docker/api/Dockerfile
@@ -0,0 +1,20 @@
+FROM node:24-bookworm-slim
+
+ARG STACKS_API_REV=da67d3cde83ec0f0275ab418a67fb1b471a4b4e7
+
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends ca-certificates git \
+    && rm -rf /var/lib/apt/lists/*
+
+RUN git clone https://github.com/hirosystems/stacks-blockchain-api.git /app \
+    && cd /app \
+    && git checkout "$STACKS_API_REV"
+
+WORKDIR /app
+COPY pox5-stake-update.patch /tmp/pox5-stake-update.patch
+RUN git apply /tmp/pox5-stake-update.patch \
+    && npm ci --no-audit \
+    && npm run build \
+    && npm prune --production
+
+CMD ["node", "./lib/index.js"]
